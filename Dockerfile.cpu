ARG CUDA_VERSION
ARG UBUNTU_VERSION=24.04

FROM ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ARG TZ
ARG LLVM_VERSION
ARG IMAGE_VERSION
ARG IMAGE_NAME

LABEL maintainer="JamesNULLiu jamesnulliu@gmail.com"
LABEL version=${IMAGE_VERSION}

ENV IMAGE_NAME=${IMAGE_NAME}
ENV UV_HOME=/opt/uv
ENV RUSTUP_HOME=/usr/local/rustup

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Config files
COPY data/install-common.sh /usr/local/bin/install-common.sh

# Default dotfiles + toolchain script -- copied into $HOME on first shell,
# like /etc/skel for useradd -m (see /etc/jnl-dl/bootstrap.sh, hooked from
# bash startup by install-common.sh so it works under any runtime).
COPY data/bootstrap.sh /etc/jnl-dl/bootstrap.sh
COPY data/.bashrc /etc/jnl-dl/skel/.bashrc
COPY data/.bash_profile /etc/jnl-dl/skel/.bash_profile
COPY data/.inputrc /etc/jnl-dl/skel/.inputrc
COPY data/.tmux.conf /etc/jnl-dl/skel/.tmux.conf
COPY data/.vimrc /etc/jnl-dl/skel/.vimrc
COPY data/.npmrc /etc/jnl-dl/skel/.npmrc
COPY data/.env_setup.sh /etc/jnl-dl/skel/.env_setup.sh
COPY data/.env_setup_functions.sh /etc/jnl-dl/skel/.env_setup_functions.sh
COPY data/.env_setup_banner.sh /etc/jnl-dl/skel/.env_setup_banner.sh

# Claude Code status line. Only settings.json's statusLine key is shipped -- the
# file is seeded by bootstrap.sh's copy-if-missing, so a workspace that already
# has its own settings.json (model, effort, theme, permissions) keeps it.
COPY data/.claude/statusline-command.sh /etc/jnl-dl/skel/.claude/statusline-command.sh
COPY data/.claude/settings.json /etc/jnl-dl/skel/.claude/settings.json

RUN chmod +x /usr/local/bin/install-common.sh && \
    /usr/local/bin/install-common.sh && \
    rm -f /usr/local/bin/install-common.sh

COPY data/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT [ "entrypoint.sh" ]
CMD [ "bash" ]
